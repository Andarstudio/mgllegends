<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Standoff 2 Esports</title>
<style>
:root{--bg:#0b0d10;--card:#151a20;--text:#eef1f5;--mut:#8a94a3;--acc:#ff6a00;--line:#262d36;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f3f4f6;--card:#fff;--text:#111;--mut:#667;--line:#ddd}}
:root[data-theme="dark"]{--bg:#0b0d10;--card:#151a20;--text:#eef1f5;--mut:#8a94a3;--line:#262d36}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;min-height:100vh}
.wrap{max-width:560px;margin:0 auto;padding:20px 16px}
h1{font-size:34px;letter-spacing:2px;margin:0;text-transform:uppercase}
h1 span{color:var(--acc)}
.tag{color:var(--mut);margin:6px 0 24px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:16px}
.hero{text-align:center;padding:40px 20px;border-top:3px solid var(--acc)}
button{background:var(--acc);color:#fff;border:0;border-radius:10px;padding:14px 22px;font-size:17px;font-weight:700;cursor:pointer;width:100%}
button:disabled{opacity:.5}
input{width:100%;padding:14px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);font-size:17px;margin-bottom:12px}
.hide{display:none}
.stats{display:flex;gap:10px}
.stats div{flex:1;text-align:center;background:var(--bg);border-radius:10px;padding:12px}
.stats b{display:block;font-size:22px;color:var(--acc)}
.stats small{color:var(--mut)}
ul{list-style:none;padding:0;margin:0}
li{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line)}
li small{color:var(--mut)}
.ok{color:#2ecc71;font-weight:700}
.note{color:var(--mut);font-size:13px;margin-top:10px}
</style>
</head>
<body>
<div class="wrap">
  <h1>Standoff <span>2</span></h1>
  <p class="tag">MGL-Legends тэмцээн</p>

  <div class="card stats">
    <div><b>1VS1</b><small>Төрөл</small></div>
    <div><b>Хутга</b><small>Шагнал</small></div>
    <div><b>2026/10/13 19:00 цагаас</b><small>Хэзээ</small></div>
  </div>

  <!-- Step 1 -->
  <div id="s1" class="card hero">
    <h2 style="margin-top:0">Чи бэлнэ үү?</h2>
    <p class="tag">Товчыг дарж эхлэнэ үү</p>
    <button id="ready">Би бэлэн</button>
  </div>

  <!-- Step 2 -->
  <div id="s2" class="card hide">
    <h2 style="margin-top:0">Нэр,болон id-гаа бичнэ үү.</h2>
    <input id="nick" placeholder="Өөрийн нэр болон Standoff 2 нэр" maxlength="24" autocomplete="off">
    <input id="gid" placeholder="Standoff 2 ID гаа бичнэ үү" maxlength="20" autocomplete="off">
    <button id="send">Бүртгэгч рүү явуулах</button>
    <p id="err" class="note"></p>
  </div>

  <!-- Step 3 -->
  <div id="s3" class="card hero hide">
    <h2 class="ok" style="margin-top:0">Чи орлоо <span id="who"></span>!</h2>
    <p class="tag">Энэ бүртгэгч рүү шилчүүлэгдэв..</p>
  </div>

  <!-- Owner list -->
  <div id="admin" class="card hide">
    <h3 style="margin-top:0">Бүртгэгдсэн тоглогчид (<span id="cnt">0</span>)</h3>
    <ul id="list"></ul>
  </div>
</div>

<script>
const $=id=>document.getElementById(id);
let db=null, user=null;
function show(id){["s1","s2","s3"].forEach(x=>$(x).classList.toggle("hide",x!==id));}
$("ready").onclick=()=>show("s2");

(async()=>{
  try{ user=await claude.use("user"); db=await claude.use("db"); }catch(e){}
  try{
    if(user && user.canEdit() && db){
      $("admin").classList.remove("hide");
      db.collection("players").orderBy("t","desc").onSnapshot(snap=>{
        $("cnt").textContent=snap.size;
        const ul=$("list"); ul.innerHTML="";
        snap.docs.forEach(d=>{
          const p=d.data()||{}; const li=document.createElement("li");
          const a=document.createElement("span"); a.textContent=p.name||"?";
          const b=document.createElement("small");
          b.textContent=(p.gid?p.gid+" · ":"")+new Date(p.t||0).toLocaleString();
          li.append(a,b); ul.append(li);
        });
      },()=>{});
    }
  }catch(e){}
})();

$("send").onclick=async()=>{
  const name=$("nick").value.trim();
  if(!name){$("err").textContent="Please enter your name.";return;}
  const rec={name,gid:$("gid").value.trim(),t:Date.now()};
  $("send").disabled=true; $("err").textContent="";
  try{
    if(!db) db=await claude.use("db");
    if(!db) throw new Error("no-db");
    await db.collection("players").add(rec);
    $("who").textContent=name; show("s3");
  }catch(e){
    $("send").disabled=false;
    $("err").textContent="Couldn't send. Make sure you're signed in to Claude and the organizer shared this page with edit/contribute access.";
  }
};
</script>
</body>
</html>
